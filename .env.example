# Copy to .env and adjust. Every setting is optional.

# Where your local model server listens (OpenAI-compatible API)
#   LM Studio: http://localhost:1234/v1   (default)
#   Ollama:    http://localhost:11434/v1
#   llama.cpp: http://localhost:8080/v1
POLEMIX_BASE_URL=http://localhost:1234/v1

# Model id; leave empty to use whichever model is loaded on the server
POLEMIX_MODEL=

# Only needed if your server requires a key
POLEMIX_API_KEY=not-needed

POLEMIX_ROUNDS=3
POLEMIX_TEMPERATURE=0.7
POLEMIX_MAX_TOKENS=600
POLEMIX_OUTPUT_DIR=debates
